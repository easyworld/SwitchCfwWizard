<Window x:Class="SwitchCfwWizard.SdReset.NoticeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switch CFW Wizard"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI, Meiryo"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!-- 自绘边框：系统 MessageBox 用的是 Win32 外观，在深浅两套主题下都和主界面不是一套。
         这里用与卡片一致的圆角/描边/字体，弹窗才像这个程序的一部分。 -->
    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="22,18,22,18"
            Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.22" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <Grid x:Name="HeaderBar" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Heading" Style="{StaticResource TitleText}" FontSize="16"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="✕" Style="{StaticResource LinkButton}"
                        FontSize="13" Padding="6,0" Margin="10,0,0,0" Click="Cancel_Click" />
            </Grid>

            <TextBlock x:Name="Body" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                       LineHeight="21" Margin="0,12,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}"
                        MinWidth="88" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}"
                        MinWidth="96" IsDefault="True" Click="Primary_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
