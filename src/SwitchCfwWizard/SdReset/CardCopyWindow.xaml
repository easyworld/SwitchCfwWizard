<Window x:Class="SwitchCfwWizard.SdReset.CardCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SwitchCfwWizard.Localization"
        Title="{loc:Loc CardCopy.Title}"
        Icon="/ico.ico"
        Width="820"
        Height="760"
        MinWidth="700"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI, Meiryo"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!--
        ⚠️ 这个窗口的字体/渲染设置必须与 MainWindow 一致（同样的四个属性）。
        上一轮 SdResetWindow 少了它们，用户一眼就看出「弹窗和界面不是一个东西」。
    -->

    <Window.Resources>
        <Style x:Key="EntryName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ 标题 ══ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{loc:Loc CardCopy.Title}" Style="{StaticResource TitleText}" FontSize="21" />
            <TextBlock Text="{loc:Loc CardCopy.Subtitle}"
                       Style="{StaticResource HintText}"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ══ ① 选择 TF 卡 ══ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc CardCopy.Step.Device}" Style="{StaticResource SectionHeaderText}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="DevicePicker"
                                      DisplayMemberPath="Display"
                                      MinHeight="38"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="Device_Changed" />

                            <Button Grid.Column="1"
                                    x:Name="RefreshButton"
                                    Content="{loc:Loc CardCopy.Refresh}"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="96" Margin="10,0,0,0"
                                    Click="Refresh_Click" />
                        </Grid>

                        <TextBlock x:Name="DeviceDetails"
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />

                        <TextBlock Text="{loc:Loc CardCopy.KeepNote}"
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- ══ ② 清空方式（用户 2026-11-20 要求：可不清空直接复制） ══ -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc CardCopy.Step.Mode}" Style="{StaticResource SectionHeaderText}" />

                        <CheckBox x:Name="SkipClearCheck"
                                  Content="{loc:Loc CardCopy.SkipClear}"
                                  IsChecked="False"
                                  Margin="0,10,0,0"
                                  Checked="SkipClear_Changed"
                                  Unchecked="SkipClear_Changed" />

                        <TextBlock Text="{loc:Loc CardCopy.SkipClear.Note}"
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap" Margin="22,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- ══ ③ 卡上现有内容 ══ -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc CardCopy.Step.Content}" Style="{StaticResource SectionHeaderText}" />

                        <TextBlock x:Name="ContentHint"
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />

                        <ListBox x:Name="EntryList"
                                 Margin="0,10,0,0"
                                 MaxHeight="300"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Name}" Style="{StaticResource EntryName}" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding SizeText}"
                                                       Style="{StaticResource HintText}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0" />

                                            <TextBlock x:Name="TagText"
                                                       Text="{Binding TagText}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource DangerBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Keep}" Value="True">
                                            <Setter TargetName="TagText" Property="Foreground"
                                                    Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyHint"
                                   Text="{loc:Loc CardCopy.Content.Empty}"
                                   Style="{StaticResource HintText}"
                                   Margin="0,8,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- ══ 结果 ══ -->
                <Border x:Name="ResultPanel"
                        Style="{StaticResource Card}"
                        Margin="0,12,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ResultTitle" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock x:Name="ResultBody"
                                   Style="{StaticResource BodyText}"
                                   TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ══ 底部：进度 + 按钮 ══ -->
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <ProgressBar x:Name="CopyProgress"
                         Style="{StaticResource FlatProgressBar}"
                         Height="6" Minimum="0" Maximum="100" Value="0" />

            <TextBlock x:Name="StatusText"
                       Style="{StaticResource BodyText}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CloseButton"
                        Content="{loc:Loc CardCopy.Button.Close}"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="88" Click="Close_Click" />

                <Button x:Name="StartButton"
                        Content="{loc:Loc CardCopy.Button.Copy}"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="140" Margin="10,0,0,0"
                        Click="Start_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
